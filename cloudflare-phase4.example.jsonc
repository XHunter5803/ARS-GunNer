{
  // Reference only. Sites owns the real production binding wiring.
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "SOCIAL_PUBLISHING_ENABLED": "false",
    "WORKERS_AI_MODEL": "@cf/zai-org/glm-4.7-flash"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ars-gunner-newsroom",
      "database_id": "REPLACE_WITH_REAL_D1_DATABASE_ID"
    }
  ]
}
