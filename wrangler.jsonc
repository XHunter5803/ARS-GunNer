{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ars-gunner-newsroom",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ars-gunner-newsroom",
      "database_id": "657ccff9-615f-4b6f-b45c-9f5ce7e5fe22",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "WORKERS_AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "WORKERS_AI_RERANKER_MODEL": "@cf/baai/bge-reranker-base",
    "SOCIAL_PUBLISHING_ENABLED": "false"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
